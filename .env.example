# API Configuration
# Base URL for the stromligning.dk API
VITE_API_BASE=https://stromligning.dk

# Mock API Configuration
# Set to 'true' to enable MSW mock API interceptors
# When enabled, API calls are intercepted and return mock data
VITE_USE_MOCK_API=false

# Škoda proxy (optional)
# URL of a self-hosted Škoda proxy (see docs/skoda-proxy-spec.md). Users can turn the
# connection on and off, but can't change the URL. Without it, the Škoda connection is hidden.
# The production build adds this origin to the Content-Security-Policy connect-src.
VITE_SKODA_PROXY_URL=
